# Database
# For local dev (SQLite fallback):
DATABASE_URL="file:./dev.db"
# For production (PostgreSQL required):
# DATABASE_URL="postgresql://user:password@localhost:5432/onvyra?schema=public"

# Auth - REQUIRED in production, min 32 chars
# Supports JWT_SECRET or AUTH_SECRET alias
JWT_SECRET="change-this-to-32+chars-random-secret-min"
# AUTH_SECRET="change-this-to-32+chars-random-secret-min"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="12"

# App - REQUIRED for OAuth and Stripe
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# For production, set to your domain https://yourapp.com
# NEXT_PUBLIC_APP_URL="https://onvyra.ai"
NODE_ENV="development"

# OpenAI / AI Provider - OPTIONAL, mock fallback when absent
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT_MS="30000"
OPENAI_MAX_RETRIES="2"

# HubSpot CRM Integration - OPTIONAL, shows NOT CONFIGURED when absent
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/api/integrations/hubspot/callback"
HUBSPOT_SCOPES="crm.objects.contacts.read crm.objects.deals.read crm.objects.engagements.read"

# Encryption for tokens at rest (32 bytes hex, generate with: openssl rand -hex 32)
# REQUIRED in production if HubSpot used
TOKEN_ENCRYPTION_KEY=""

# Billing - Stripe - OPTIONAL, shows Billing not configured when absent
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
# Aliases per Sprint 6 spec (both supported):
# STRIPE_PRICE_ID_PRO=""
# STRIPE_PRICE_ID_BUSINESS=""

# Rate Limiting (optional, defaults to in-memory)
# For production distributed limiting, set Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Observability
LOG_LEVEL="info"
SENTRY_DSN=""

# Security
CSRF_SECRET=""

# Feature flags
ENABLE_DEMO_MODE="true"
ENABLE_BILLING="false"
