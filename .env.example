# Database
# For local dev (SQLite fallback):
DATABASE_URL="file:./dev.db"
# For production (PostgreSQL required):
# DATABASE_URL="postgresql://user:password@localhost:5432/onvyra?schema=public"

# Auth
JWT_SECRET="change-this-to-32+chars-random-secret-min"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="12"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# OpenAI / AI Provider
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT_MS="30000"
OPENAI_MAX_RETRIES="2"

# HubSpot CRM Integration
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/api/integrations/hubspot/callback"
HUBSPOT_SCOPES="crm.objects.contacts.read crm.objects.deals.read crm.objects.engagements.read"

# Encryption for tokens at rest (32 bytes hex or base64, generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=""

# Billing - Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""

# Rate Limiting (optional, defaults to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Observability
LOG_LEVEL="info"
SENTRY_DSN=""

# Security
CSRF_SECRET=""

# Feature flags
ENABLE_DEMO_MODE="true"
ENABLE_BILLING="false"
